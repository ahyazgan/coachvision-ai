# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma
/prisma/migrations/dev.db*
/prisma/dev.db
/prisma/dev.db-journal

# IDE
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Python
apps/python/.venv/
apps/python/__pycache__/
apps/python/**/__pycache__/
apps/python/*.pyc
apps/python/yolov8*.pt

# Yüklenen videolar ve frame'ler
/uploads/videos/*
/uploads/frames/*
!/uploads/.gitignore

# Pipeline ön izleme görselleri (her video için)
/public/previews/

# Python çalışma dizininden oluşan analiz dosyaları
apps/python/uploads/
