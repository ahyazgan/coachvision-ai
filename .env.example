# =========================================
# CoachVision AI - Ortam Değişkenleri Şablonu
# Kopyala: cp .env.example .env.local
# =========================================

# --- Veritabanı ---
# Yerel PostgreSQL veya Neon/Supabase ücretsiz katmanı kullanılabilir.
DATABASE_URL="postgresql://user:password@localhost:5432/coachvision"

# --- NextAuth ---
# Şunu üret: openssl rand -base64 32
NEXTAUTH_SECRET="degistir-32-karakter-rastgele-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (opsiyonel - dev'de credentials provider yeterli)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- AI API'leri ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Sesli AI için (Faz 3, şimdi gerekli değil)
ELEVENLABS_API_KEY=""

# Whisper yedek (Faz 3)
OPENAI_API_KEY=""

# --- Python AI Backend ---
PYTHON_API_URL="http://localhost:8000"

# --- Video Ayarları ---
MAX_VIDEO_SIZE_MB=2000
VIDEO_UPLOAD_DIR="./uploads/videos"
FRAME_EXTRACT_DIR="./uploads/frames"
FRAME_INTERVAL_SECONDS=2

# --- Storage (üretimde) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET=""

# --- Diğer ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
